{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows-Analysis",
  "version": "1.3.9",
  "identifier": "com.windows-analysis.viewer",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:next",
    "beforeBuildCommand": "npm run build:next"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Windows-Analysis",
        "width": 1680,
        "height": 1020,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "backgroundColor": "#1e1e1e",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
